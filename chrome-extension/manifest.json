{
  "manifest_version": 3,
  "name": "拾音本机网易云登录助手",
  "version": "1.0.0",
  "description": "经用户点击后，将当前 Chrome 的网易云登录状态安全导入本机拾音播放器。",
  "key": "",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://music.163.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}